# Server
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000
BODY_LIMIT=5mb

# Redis
REDIS_URL=redis://localhost:6379

# Authentication (space-separated for multiple tokens)
AUTH_TOKEN=your-secret-token
# Auth headers to check (space-separated, checked in order)
AUTH_HEADERS=X-Auth-Token x-rapidapi-key

# Execution Limits
DEFAULT_CPU_TIME_LIMIT=5
MAX_CPU_TIME_LIMIT=15
DEFAULT_WALL_TIME_LIMIT=10
MAX_WALL_TIME_LIMIT=30
DEFAULT_MEMORY_LIMIT=128000
MAX_MEMORY_LIMIT=512000
MAX_PROCESSES=60
MAX_BATCH_SIZE=20
MAX_SOURCE_SIZE=65536
MAX_ADDITIONAL_FILES_SIZE=2097152

# Worker
# Number of parallel jobs per worker. Also sets the default warm-pool size
# for each pool (DB + language). Must be a positive integer — the worker
# exits non-zero if this is unset, 0, negative, or non-numeric.
WORKER_CONCURRENCY=4

# ── Warm Container Pools ────────────────────────────────────────────────────

# ==============================================================================
# Per-Language Enable & Pool Configuration
# ==============================================================================
# LANGUAGE_<SLUG>_ENABLED: default true, except mongodb = false
# LANGUAGE_<SLUG>_POOL: default true for database languages, false for all others
# Slugs: c, cpp, java, javascript, typescript, python, sqlite, postgresql, mysql, mongodb, multi
#
# LANGUAGE_C_ENABLED=true
# LANGUAGE_C_POOL=false
# LANGUAGE_CPP_ENABLED=true
# LANGUAGE_CPP_POOL=false
# LANGUAGE_JAVA_ENABLED=true
# LANGUAGE_JAVA_POOL=false
# LANGUAGE_JAVASCRIPT_ENABLED=true
# LANGUAGE_JAVASCRIPT_POOL=false
# LANGUAGE_TYPESCRIPT_ENABLED=true
# LANGUAGE_TYPESCRIPT_POOL=false
# LANGUAGE_PYTHON_ENABLED=true
# LANGUAGE_PYTHON_POOL=false
# LANGUAGE_SQLITE_ENABLED=true
# LANGUAGE_SQLITE_POOL=false
# LANGUAGE_POSTGRESQL_ENABLED=true
# LANGUAGE_POSTGRESQL_POOL=true
# LANGUAGE_MYSQL_ENABLED=true
# LANGUAGE_MYSQL_POOL=true
# LANGUAGE_MONGODB_ENABLED=false
# LANGUAGE_MONGODB_POOL=true

# ── Warm Container Pools ────────────────────────────────────────────────────
# Warm container pooling is configured per language via LANGUAGE_<SLUG>_POOL.
# By default, database languages (postgresql, mysql, mongodb) have POOL=true,
# while standard languages (python, javascript, c, cpp, java, typescript, sqlite)
# default to POOL=false.
#
# Override individual pool sizes (must be integers >= 1).
# If not set, each active pool defaults to WORKER_CONCURRENCY (or WORKER_DB_CONCURRENCY).
#
# Database pool size overrides:
#LANGUAGE_POSTGRESQL_POOL_SIZE=4
#LANGUAGE_MYSQL_POOL_SIZE=4
#LANGUAGE_MONGODB_POOL_SIZE=4
#
# Standard language pool size overrides (active when LANGUAGE_<SLUG>_POOL=true):
#LANGUAGE_PYTHON_POOL_SIZE=2
#LANGUAGE_JAVASCRIPT_POOL_SIZE=2
#LANGUAGE_TYPESCRIPT_POOL_SIZE=2
#LANGUAGE_JAVA_POOL_SIZE=2
#LANGUAGE_C_POOL_SIZE=2
#LANGUAGE_CPP_POOL_SIZE=2
#LANGUAGE_SQLITE_POOL_SIZE=2

# Global cap on how many containers may boot simultaneously across all pools.
# Raise on machines with fast I/O; lower on constrained hosts to avoid
# overwhelming the daemon at startup.
WARM_POOL_MAX_CONCURRENT_BOOTS=3

# Cache
RESULT_CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SUBMISSIONS_WINDOW_MS=60000
RATE_LIMIT_SUBMISSIONS_MAX=120

# Queue Backpressure Limits
# Defaults derived from WORKER_CONCURRENCY (code: concurrency * 25, DB: concurrency * 5)
#MAX_QUEUE_DEPTH=100
#MAX_DB_QUEUE_DEPTH=20

# Docker Settings
DOCKER_SOCKET=/var/run/docker.sock
CONTAINER_TIMEOUT=30000

# ── Production resource limits (docker-compose.prod.yml) ───────────────────
# Defaults below are sized for a 2 vCPU / 8GB VPS.
# WORKER_CPUS must NOT exceed the host's vCPU count or Docker refuses to
# start the container ("Range of CPUs is from 0.01 to N.00").
WORKER_CPUS=1.5
WORKER_MEMORY=4G
API_CPUS=0.25
API_MEMORY=256M
REDIS_CPUS=0.25
REDIS_MEMORY=384M
REDIS_MAXMEMORY=256mb
CADDY_CPUS=0.25
CADDY_MEMORY=128M
PROMETHEUS_CPUS=0.25
PROMETHEUS_MEMORY=512M
PROMETHEUS_RETENTION=7d
GRAFANA_CPUS=0.25
GRAFANA_MEMORY=256M

# Domain. This single variable selects how CodeRunner is served.
#
#   DOMAIN=                         -> plain HTTP on this server's IP, port 80.
#                                      No DNS record and no certificate needed.
#                                      Traffic and API tokens travel in cleartext.
#
#   DOMAIN=coderunner.example.com   -> automatic HTTPS via Let's Encrypt.
#                                  Needs an A record already pointing at this
#                                  server and ports 80+443 reachable (check the
#                                  provider's panel firewall as well as ufw).
#
# Leave it blank to start without a domain; fill it in and re-run
# `docker compose -f docker-compose.prod.yml up -d` to switch to HTTPS later.
DOMAIN=
METRICS_TOKEN=change-me
GRAFANA_PASSWORD=change-me
