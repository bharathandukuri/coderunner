# Site address set by docker-compose:
#   DOMAIN unset/blank -> ":80"  -> plain HTTP on every IP, no certificate
#   DOMAIN=example.com -> {$DOMAIN} -> automatic HTTPS via Let's Encrypt
{$SITE_ADDRESS::80} {
    # Request body size limit
    request_body {
        max_size 50MB
    }

    # Block public access to /metrics completely (Prometheus scrapes via internal network)
    @blocked_metrics {
        path /metrics*
    }
    handle @blocked_metrics {
        respond "Forbidden" 403
    }

    # Reverse proxy to API with 30s response header timeout (supports wait=true 15s budget + margin)
    reverse_proxy api:3000 {
        transport http {
            response_header_timeout 30s
        }
    }

    # Compression
    encode gzip

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Server
    }

    # JSON access logging with log rotation
    log {
        output file /var/log/caddy/access.log {
            roll_size 10mb
            roll_keep 5
            roll_keep_for 720h
        }
        format json
    }
}

# Subdomain for Grafana when DOMAIN is configured (defaults to unexposed :8081 if unset)
{$GRAFANA_SITE_ADDRESS::8081} {
    reverse_proxy grafana:3000

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        -Server
    }

    log {
        output file /var/log/caddy/grafana.log {
            roll_size 10mb
            roll_keep 5
            roll_keep_for 720h
        }
        format json
    }
}
